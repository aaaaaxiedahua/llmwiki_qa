# === API (repo root .env, loaded by api/config.py) ===
# MODE=local is the default; WORKSPACE_PATH is set by the ./llmwiki CLI.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Local mode: QA chat + auto-ingestion. Two protocols:
#   LLM_PROTOCOL=openai    — OpenAI-compatible /chat/completions (Kimi, DeepSeek, vLLM)
#   LLM_PROTOCOL=anthropic — Anthropic /v1/messages (or a relay like a local CC Switch proxy)
# Chat is enabled when all three LLM_* are set; ingestion builds wiki pages
# automatically from new source documents via a two-step LLM pipeline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROTOCOL=openai
LLM_TIMEOUT=60
INGESTION_ENABLED=false
INGESTION_MAX_RETRIES=3
INGESTION_UPDATE_OVERVIEW=true

# === Web (.env.local in web/) ===
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MODE=local
# Development only: preview both onboarding steps without auth or API writes.
# NEXT_PUBLIC_ONBOARDING_PREVIEW=true
