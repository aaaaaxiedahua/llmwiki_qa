# === API (repo root .env, loaded by api/config.py) ===
# MODE=local is the default; WORKSPACE_PATH is set by the ./llmwiki CLI.
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# Local mode: QA chat + auto-ingestion. Two protocols:
#   LLM_PROTOCOL=openai    — OpenAI-compatible /chat/completions (Kimi, DeepSeek, vLLM)
#   LLM_PROTOCOL=anthropic — Anthropic /v1/messages (or a relay like a local CC Switch proxy)
# Chat is enabled when all three LLM_* are set; ingestion builds wiki pages
# automatically from new source documents via a two-step LLM pipeline.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_PROTOCOL=openai
LLM_TIMEOUT=60
INGESTION_ENABLED=false
INGESTION_MAX_RETRIES=3
INGESTION_UPDATE_OVERVIEW=true

# Vector semantic retrieval (optional, local mode). Two embedding backends:
#   EMBEDDING_BACKEND=api   — OpenAI-compatible /embeddings; needs all three
#                             EMBEDDING_* below (independent of LLM_*; SiliconFlow
#                             has free BGE: https://api.siliconflow.cn/v1)
#   EMBEDDING_BACKEND=local — offline BGE via fastembed/onnxruntime
#                             (pip install fastembed), no API config needed
# When neither is configured, search is pure FTS and behaves exactly as before.
EMBEDDING_BACKEND=local
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
# LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Vector store: Qdrant. VECTOR_BACKEND=qdrant = embedded local mode (no server,
# data under .llmwiki/qdrant/); VECTOR_BACKEND=qdrant-server + QDRANT_URL for a
# Docker server with dashboard. Requires: pip install qdrant-client
VECTOR_BACKEND=qdrant
# QDRANT_URL=http://localhost:6333
# After enabling on an existing workspace, backfill once: ./llmwiki embed <workspace>

# === Web (.env.local in web/) ===
# NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_MODE=local
# Development only: preview both onboarding steps without auth or API writes.
# NEXT_PUBLIC_ONBOARDING_PREVIEW=true
